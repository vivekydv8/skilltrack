# SkillTrackAI Environment Configuration
# Default: SQLite (runs immediately with zero setup). 
# For PostgreSQL: uncomment below line:
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/skilltrackai
DATABASE_URL=sqlite:///./skilltrackai.db

SECRET_KEY=sih26135-maharashtra-skilltrack-secret-key-2026

# =====================================================================
# Real Twilio SMS Integration
# 1. Sign up for a free Twilio trial account at https://www.twilio.com/try-twilio
# 2. Copy Account SID & Auth Token from Twilio Console
# 3. Paste them below to send REAL SMS to candidates during follow-up triggers:
# =====================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend URL for candidate survey links sent inside SMS
FRONTEND_URL=http://localhost:5173
